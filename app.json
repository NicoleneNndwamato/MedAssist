{
  "expo": {
    "name": "MedAssist",
    "slug": "medassist",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MedAssist to access your microphone so you can talk to the assistant.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "android": {
      "package": "com.medassist.app"
    },
    "ios": {
      "bundleIdentifier": "com.medassist.app"
    }
  }
}
