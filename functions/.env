# Copy this file to functions/.env and fill in real values.
# functions/.env is loaded automatically by Firebase Functions (2nd gen)
# both in the emulator and on deploy - you don't need to do anything extra
# to wire it up, just don't commit the real .env file (see functions/.gitignore).

# --- Azure AI Speech (speech-to-text + text-to-speech) ---
# Free tier (F0): ~5 audio hours/month STT, ~0.5 million characters/month TTS.
AZURE_SPEECH_KEY=DNXK1dbv1tulwTJUT1CBeDOe9SNl6hHEunAiOApQKYlp9WHf9JUEJQQJ99CIACrIdLPXJ3w3AAAYACOGvIsQ
AZURE_SPEECH_REGION=southafricanorth

# --- Azure AI Translator ---
# Free tier (F0): 2 million characters/month.
AZURE_TRANSLATOR_KEY=DNXK1dbv1tulwTJUT1CBeDOe9SNl6hHEunAiOApQKYlp9WHf9JUEJQQJ99CIACrIdLPXJ3w3AAAYACOGvIsQ
AZURE_TRANSLATOR_REGION=southafricanorth
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# --- Existing Anthropic key (used by the OLD voiceTurn function only) ---
# Left here for reference - this one is actually loaded via Firebase Secrets
# (defineSecret), not this .env file. See functions/index.js.
# ANTHROPIC_API_KEY is set with: firebase functions:secrets:set ANTHROPIC_API_KEY

# --- SignalWire (the actual phone number people call) ---
# Project ID and API Token are both in your SignalWire Space dashboard
# (my.signalwire.com) under API section - Project ID is shown there
# directly, API Token is created via "Create new token" (treat it like a
# password, shown only once).
SIGNALWIRE_PROJECT_ID=43963c76-4571-4ba3-82a3-51f6ff008ccb
SIGNALWIRE_API_TOKEN=swapi_Il1mtGDa4JrsM5ne8nmHu3GSK0G5PFqtrmeu


# --- Your deployed functions' base URL ---
# Plivo's action= callback URLs must be absolute, so this is how the code
# builds them. Format: https://<region>-<project-id>.cloudfunctions.net
FUNCTIONS_BASE_URL=https://us-central1-medassist-397be.cloudfunctions.net
